DATABASE_URL=sqlite:///./var/spd.db
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Generate a local secret with: python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=replace-with-a-random-local-secret-at-least-32-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://127.0.0.1:4180","http://localhost:4180"]
SESSION_TTL_SECONDS=86400
RUN_TIMEOUT_SECONDS=45
LEASE_SECONDS=90
MAX_TOOL_CALLS=8
# PostgreSQL target: postgresql+psycopg://spd:password@127.0.0.1:5432/spd
# Embedding is NOT provided by the DeepSeek key. No vectors are generated in M1.

# Optional explicit live Agent tracing; worker restart required.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=spd-local-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
